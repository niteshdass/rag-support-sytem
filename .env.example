# Node environment: development | test | production
NODE_ENV=development

# Express port
PORT=3000

# MongoDB — URI must contain "dev", "test", or "local" (seeder safety guard)
MONGODB_URI=mongodb://localhost:27017/supportpilot-dev

# Session secret — minimum 32 chars; generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-plus-character-string-in-production

# Storage driver: local | (minio in future)
STORAGE_DRIVER=local
