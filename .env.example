# Node environment: development | test | production
NODE_ENV=development

# Express port
PORT=3000

# MongoDB — URI must contain "dev", "test", or "local" (seeder safety guard)
MONGODB_URI=mongodb://localhost:27017/supportpilot-dev

# Session secret — minimum 32 chars; generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-32-plus-character-string-in-production

# Storage driver: local | (minio in future)
STORAGE_DRIVER=local

# Qdrant vector store URL (native binary, see docs/local-setup.md)
QDRANT_URL=http://localhost:6333

# Meilisearch (native binary, see docs/local-setup.md)
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=

# Langfuse tracing — optional; tracing disabled if any of these are unset
# Self-host: https://langfuse.com/docs/deployment/self-host
LANGFUSE_HOST=http://localhost:3030
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# PII redaction — optional Presidio sidecar (see presidio-sidecar/README.md)
# If unset, falls back to regex-based redaction (emails + phone numbers)
REDACT_URL=
# Set to true to redact queries before they reach the LLM (off by default)
PII_BLOCK_LLM=false
